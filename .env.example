# Covers BOTH speech-to-text and text-to-speech.
# Free $200 credit, no card: https://console.deepgram.com
DEEPGRAM_API_KEY=

# The brain. Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# LiveKit - only needed for browser testing (`lk agent dev`).
# `lk agent console` runs with no LiveKit account at all.
# ---------------------------------------------------------------------------

# Which LiveKit server to register with: cloud | local
LIVEKIT_MODE=cloud

# LIVEKIT_MODE=cloud reads these. Get them from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LIVEKIT_MODE=local targets a `livekit-server --dev` running on your machine.
#   brew install livekit && livekit-server --dev
# These are livekit-server's fixed dev credentials - public by design, not
# secrets. Only override if you changed the server's config.
# LIVEKIT_LOCAL_URL=ws://127.0.0.1:7880
# LIVEKIT_LOCAL_API_KEY=devkey
# LIVEKIT_LOCAL_API_SECRET=secret

# Explicit dispatch: leave UNSET for browser testing (an unnamed worker joins
# every room, which is what the Agent Console needs). Set it when you add SIP
# telephony, which dispatches by name.
# LIVEKIT_AGENT_NAME=receptionist

# ---------------------------------------------------------------------------
# Pipeline selection. Defaults shown; uncomment to override.
# ---------------------------------------------------------------------------

# STT. Both Flux models do end-of-turn detection inside the model.
# flux-general-en is the default and is English-only. LANGUAGE_PROFILE=hinglish
# switches this to flux-general-multi automatically, so you rarely set it here.
# STT_MODEL=flux-general-en
# STT_LANGUAGE_HINTS=en          # only honoured by flux-general-multi
# STT_EOT_THRESHOLD=0.7          # 0.5-0.9. Higher = waits longer before replying.
# STT_EOT_TIMEOUT_MS=3000

# Preemptive generation. Deepgram signals a likely end-of-turn at this
# confidence, so the LLM starts generating before the caller has finished.
# Must be <= STT_EOT_THRESHOLD. One of the biggest latency wins available.
# Set to 0 to disable. Lower = starts sooner, wastes more speculative work.
# STT_EAGER_EOT_THRESHOLD=0.4

# LLM
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.4
# Hard cap on reply length. Long replies are slow to speak and bad on a call.
# LLM_MAX_TOKENS=200

# ---------------------------------------------------------------------------
# Language. This one variable sets STT model, language hints and TTS provider
# together, so they cannot drift apart.
#   english (default) -> Flux English + Deepgram Aura-2, US accent.
#                        Needs no key beyond DEEPGRAM_API_KEY.
#   hinglish          -> Flux multilingual + Rumik mulberry, for Hindi and
#                        Hinglish. Needs RUMIK_API_KEY.
# ---------------------------------------------------------------------------
# LANGUAGE_PROFILE=english

# To switch to Hindi and Hinglish, set BOTH of these:
#   LANGUAGE_PROFILE=hinglish
#   RUMIK_API_KEY=...            https://playground.rumik.ai
# The profile picks Rumik automatically, so TTS_PROVIDER can stay unset.
# Only needed for the hinglish profile; leave empty otherwise.
RUMIK_API_KEY=

# Overrides. Any of these beat the profile. Model defaults per provider:
#   deepgram -> aura-2-asteria-en     (English only, ~$0.030/1k chars)
#   rumik    -> mulberry              (Hindi/Hinglish, ~Rs 0.50/1k chars)
#   cartesia -> sonic-3
# TTS_PROVIDER=deepgram
# TTS_MODEL=aura-2-asteria-en

# Deepgram Aura-2 voices are labelled by accent. The default, asteria, is US
# English. Any Aura voice name works, including ones not listed here.
#   US female: andromeda asteria aurora cordelia electra harmonia hera iris
#              janus juno luna minerva phoebe selene
#   US male:   apollo arcas aries atlas hermes jupiter mars neptune odysseus
#              orion orpheus pluto saturn zeus
#   British:   draco (male)
#   Australian: theia (female), hyperion (male)
# Full catalogue: https://developers.deepgram.com/docs/tts-models
# TTS_MODEL=aura-2-asteria-en

# Voice for Rumik mulberry, used only when TTS_PROVIDER=rumik.
# IMPORTANT: leaving both of these unset does NOT mean "default voice" - Rumik
# generates a fresh voice per request, so the voice changes mid-call. The code
# always pins one for that reason.
#   female: emma mia sophia ava ira siya aisha zoya
#   male:   lucas noah theo adam
# RUMIK_SPEAKER=ira
# RUMIK_DESCRIPTION=warm, friendly Indian receptionist   # alternative to speaker
# A speaker name always wins over a description. To use RUMIK_DESCRIPTION,
# RUMIK_SPEAKER must be empty.

# For TTS_PROVIDER=cartesia:
# CARTESIA_API_KEY=
# CARTESIA_VOICE=

# ---------------------------------------------------------------------------
# Turn-taking. Both default to "auto", which picks whatever needs no LiveKit
# credentials, so console mode works standalone.
# ---------------------------------------------------------------------------

# auto | stt | vad | livekit
#   stt     -> Deepgram Flux decides end-of-turn (lowest latency, no LiveKit)
#   livekit -> LiveKit Cloud turn detector (needs credentials)
# TURN_DETECTION=auto

# auto | vad | adaptive
#   vad      -> local barge-in detection, no LiveKit needed
#   adaptive -> LiveKit Cloud detector, better at ignoring backchannel
# INTERRUPTION_MODE=auto

# ---------------------------------------------------------------------------
# Storage - leads captured on calls, and transcripts
# ---------------------------------------------------------------------------
# DATA_DIR=./data          # leads.csv and transcripts/ land here (gitignored)
# SAVE_TRANSCRIPTS=true

# LOG_METRICS=true

# Log the conversation itself: what the caller said, what the agent replied, and
# every tool call with its arguments and result. On by default. This is the only
# readable record of a call on LiveKit Cloud, where the transcript file is
# written to an ephemeral disk.
# LOG_TRANSCRIPT=true

# Also log partial transcripts. Useful for diagnosing turn detection, noisy
# otherwise: Deepgram revises a partial several times a second. Needs the log
# level at DEBUG to appear.
# LOG_INTERIM_TRANSCRIPT=false

# ---------------------------------------------------------------------------
# WhatsApp calling. Only the webhook needs these; the agent is unaware a call
# arrived over WhatsApp rather than SIP - except WHATSAPP_ACCESS_TOKEN, which
# the agent needs to hang up the WhatsApp leg when it ends the call.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# You invent this string, then paste the same value into Meta's console.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard -> App Settings -> Basic -> App Secret.
# Without it the webhook accepts any POST. Required on a public URL.
WHATSAPP_APP_SECRET=

# LiveKit documents support for Cloud API v23.0-v25.0.
# WHATSAPP_CLOUD_API_VERSION=25.0
# WHATSAPP_ROOM_PREFIX=whatsapp
# Blocks until the agent joins. Serverless functions time out, so the Vercel
# copy defaults this to false.
# WHATSAPP_WAIT_UNTIL_ANSWERED=true
# Delay before hanging up the WhatsApp leg, so the closing line is not clipped.
# WHATSAPP_HANGUP_GRACE_SECONDS=1.0

# Explicit provider overrides (the language profile normally sets these).
# STT_PROVIDER=deepgram
# LLM_PROVIDER=groq
