# Covers BOTH speech-to-text and text-to-speech.
# Free $200 credit, no card: https://console.deepgram.com
DEEPGRAM_API_KEY=

# The brain. Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# LiveKit - only needed for browser testing (`lk agent dev`).
# `lk agent console` runs with no LiveKit account at all.
# ---------------------------------------------------------------------------

# Which LiveKit server to register with: cloud | local
LIVEKIT_MODE=cloud

# LIVEKIT_MODE=cloud reads these. Get them from https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LIVEKIT_MODE=local targets a `livekit-server --dev` running on your machine.
#   brew install livekit && livekit-server --dev
# These are livekit-server's fixed dev credentials - public by design, not
# secrets. Only override if you changed the server's config.
# LIVEKIT_LOCAL_URL=ws://127.0.0.1:7880
# LIVEKIT_LOCAL_API_KEY=devkey
# LIVEKIT_LOCAL_API_SECRET=secret

# Explicit dispatch: leave UNSET for browser testing (an unnamed worker joins
# every room, which is what the Agent Console needs). Set it when you add SIP
# telephony, which dispatches by name.
# LIVEKIT_AGENT_NAME=receptionist

# ---------------------------------------------------------------------------
# Pipeline selection. Defaults shown; uncomment to override.
# ---------------------------------------------------------------------------

# STT. flux-general-multi = multilingual Flux with in-model turn detection.
# Use flux-general-en for English-only (slightly cheaper, slightly faster).
# STT_MODEL=flux-general-multi
# STT_LANGUAGE_HINTS=en,hi
# STT_EOT_THRESHOLD=0.7          # 0.5-0.9. Higher = waits longer before replying.
# STT_EOT_TIMEOUT_MS=3000

# LLM
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.4

# ---------------------------------------------------------------------------
# Language. This one variable sets STT model, language hints and TTS provider
# together, so they cannot drift apart.
#   hinglish (default) -> Flux multilingual + Rumik mulberry. Needs RUMIK_API_KEY.
#   english            -> Flux English + Deepgram Aura-2. No extra key needed.
# ---------------------------------------------------------------------------
# LANGUAGE_PROFILE=hinglish

# Required for the hinglish profile. https://playground.rumik.ai
RUMIK_API_KEY=

# Overrides. Any of these beat the profile. Model defaults per provider:
#   deepgram -> aura-2-andromeda-en   (English only, ~$0.030/1k chars)
#   rumik    -> mulberry              (Hindi/Hinglish, ~Rs 0.50/1k chars)
#   cartesia -> sonic-3
# TTS_PROVIDER=rumik
# TTS_MODEL=mulberry

# For TTS_PROVIDER=rumik (set TTS_MODEL=mulberry or muga):
# RUMIK_API_KEY=
# RUMIK_SPEAKER=ira
# RUMIK_DESCRIPTION=warm, friendly Indian receptionist

# For TTS_PROVIDER=cartesia:
# CARTESIA_API_KEY=
# CARTESIA_VOICE=

# ---------------------------------------------------------------------------
# Turn-taking. Both default to "auto", which picks whatever needs no LiveKit
# credentials, so console mode works standalone.
# ---------------------------------------------------------------------------

# auto | stt | vad | livekit
#   stt     -> Deepgram Flux decides end-of-turn (lowest latency, no LiveKit)
#   livekit -> LiveKit Cloud turn detector (needs credentials)
# TURN_DETECTION=auto

# auto | vad | adaptive
#   vad      -> local barge-in detection, no LiveKit needed
#   adaptive -> LiveKit Cloud detector, better at ignoring backchannel
# INTERRUPTION_MODE=auto

# ---------------------------------------------------------------------------
# Storage - leads captured on calls, and transcripts
# ---------------------------------------------------------------------------
# DATA_DIR=./data          # leads.csv and transcripts/ land here (gitignored)
# SAVE_TRANSCRIPTS=true

# LOG_METRICS=true
